# SEGURIDAD / JWT
SECRET_KEY=change_me_jwt_secret_key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# PROVEEDORES DE DATOS DE MERCADO
ALPHA_VANTAGE_KEY=
FINNHUB_KEY=
POLYGON_KEY=
BYMA_KEY=
BINANCE_KEY=
